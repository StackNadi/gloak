{
  "name": "securebackup",
  "version": "0.1.0",
  "description": "Bun single-binary CLI for age-encrypted chunked backups",
  "type": "module",
  "bin": {
    "securebackup": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/securebackup",
    "build:bundle": "bun build src/cli.ts --target bun --minify --outfile dist/securebackup.js"
  },
  "dependencies": {
    "age-encryption": "^0.3.0",
    "citty": "^0.2.2",
    "cli-progress": "^3.12.0",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
